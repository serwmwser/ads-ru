# ===== HiMeet Объявления: настройки сервера =====
# На сервере: cp .env.example .env  и заполните значения в .env (файл .env в git не попадает)

# Сайт
APP_NAME=HiMeet Объявления
APP_DOMAIN=https://ads.himeet.online
APP_ENV=production
PORT=3000
API_PUBLIC_URL=
# Адреса, с которых разрешены запросы к API (через запятую)
CORS_ORIGINS=https://ads.himeet.online,https://himeet.online
# 1 — если сайт работает за прокси (nginx, Caddy): берёт реальный IP посетителя
TRUST_PROXY=1

# Рынок: ru — рубли, ЮKassa, вход по SMS; intl — доллары, Stripe
MARKET=ru
INTL_CURRENCY=USD
INTL_LOCALE=en-US

# Данные (внутри контейнера это папка тома, менять не нужно)
SQLITE_FILE=./data/ads.db
UPLOAD_DIR=./data/uploads

# Сессии
SESSION_TTL_DAYS=30

# Объявления: 1 — публиковать сразу, 0 — после проверки
ADS_AUTOPUBLISH=0
FREE_ADS_LIMIT=3
PRO_ADS_LIMIT=20

# Вход по SMS (пока console — коды печатаются в журнале сервера)
SMS_PROVIDER=console
SMS_API_KEY=

# Почта (пока console — письма печатаются в журнале сервера)
EMAIL_PROVIDER=console
EMAIL_API_KEY=
EMAIL_FROM=

# Платежи в рублях: ЮKassa
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Платежи в валюте: Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=